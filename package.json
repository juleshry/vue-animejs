{
  "name": "@juleshry/vue-animejs",
  "version": "1.6.0-beta.1",
  "description": "SSR-safe Vue 3 composables, directives and components for Anime.js v4 — reactive animations that integrate naturally with Vue's reactivity system and component lifecycle.",
  "keywords": [
    "animation",
    "animejs",
    "components",
    "composable",
    "composables",
    "directives",
    "ssr",
    "vue",
    "vue3"
  ],
  "homepage": "https://vue-animejs.juleshry.dev",
  "bugs": {
    "url": "https://github.com/juleshry/vue-animejs/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/juleshry/vue-animejs.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "vp build && vue-tsc -p tsconfig.build.json",
    "format": "vp fmt .",
    "format:check": "vp fmt --check .",
    "lint": "vp lint .",
    "test": "vp test run",
    "test:watch": "vp test",
    "test:coverage": "vp test run --coverage",
    "test:e2e": "playwright test -c e2e",
    "prepare": "vp config",
    "deploy:docs": "bun --env-file=.env scripts/deploy-docs.ts",
    "release": "bun --env-file=.env scripts/release.ts"
  },
  "devDependencies": {
    "@clack/prompts": "^1.8.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.0",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "5.0.5",
    "@vue/server-renderer": "^3.5.42",
    "@vue/test-utils": "^2.5.0",
    "@vueuse/core": "^14.4.0",
    "animejs": "4.5.0",
    "bun-types": "^1.4.2",
    "happy-dom": "^20.14.5",
    "semver": "^7.8.5",
    "typescript": "^6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0",
    "vitest": "5.0.5",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11"
  },
  "peerDependencies": {
    "@vueuse/core": ">=14",
    "animejs": ">=4",
    "vue": ">=3.5"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vitest": "5.0.5"
  }
}