{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["node", "bun-types"],
    "paths": {
      "@lib": ["./src/index.ts"],
      "@src/*": ["./src/*"]
    }
  },
  "include": ["vite.config.ts", "src/**/*", "playground/**/*", "tests/**/*", "e2e/**/*", "scripts/**/*"]
}